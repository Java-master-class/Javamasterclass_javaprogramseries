import java.util.Scanner;

public class Switchpro1 
{

	public static void main(String[] args)
	{
		//char and String based inputs
		//A->65
		//Mercury
		char ip;
		String pl;
		Scanner sd=new Scanner(System.in);
		//System.out.println("enter the character");
		//ip=sd.next().charAt(0);//A
		System.out.println("enter the planet name");
		pl=sd.nextLine();
		switch(pl)
		{
		case "Mercury":
			System.out.println(pl +"is the first planet of the solar system");
			break;
		default:
			System.out.println("No such planet");
		}

	}

}
